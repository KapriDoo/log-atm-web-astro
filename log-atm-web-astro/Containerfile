# Contenedor local opcional que reproduce producción (Cloudflare Workers) con Podman rootless.
# Construir: npm run container:build · Ejecutar: npm run container:run (ver README).

# Debian/glibc (node:22-slim) y no Alpine: workerd, el runtime de Workers que usa
# `astro preview`, no publica binario para musl.
FROM docker.io/library/node:22-slim

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

# `.containerignore` deja fuera credenciales locales, dependencias, builds previos y ./chrome.
COPY . .
RUN npm run build

# Las credenciales nunca se copian a la imagen: `npm run container:run` monta el `.dev.vars`
# del equipo en solo lectura en /app/dist/server/.dev.vars, junto al config del Worker
# (dist/server/wrangler.json), que es donde el adapter de Cloudflare lo busca.
EXPOSE 4321

# `--host ::` escucha en IPv4 e IPv6: en WSL2 `localhost` resuelve a `::1` y con `0.0.0.0` el
# sitio no responde por `localhost`. Forma exec y binario local: un único proceso servidor.
CMD ["/app/node_modules/.bin/astro", "preview", "--host", "::", "--port", "4321"]
